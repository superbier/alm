---
import '@fontsource-variable/inter-tight';
import '../styles/global.css';
import site from '../data/site.json';
import fonts from '../data/fonts.json';

interface Props { title?: string; description?: string }
const {
  title = site.name,
  description = 'Niko Alm – Medienunternehmer, Publizist, Ex-Abgeordneter.',
} = Astro.props;
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline define:vars={{ fonts }}>
      // Nur für die Schriftwahl: ?font=anton zeigt die Seite mit einer anderen Überschriften-Schrift.
      // Bleibt beim Weiterklicken erhalten; ?font=inter setzt zurück.
      (function () {
        var id = new URLSearchParams(location.search).get('font');
        try {
          if (id) sessionStorage.setItem('almFont', id); else id = sessionStorage.getItem('almFont');
        } catch (e) {}
        var f = fonts.find(function (x) { return x.id === id; });
        if (!f || f.id === 'inter') return;
        var l = document.createElement('link');
        l.rel = 'stylesheet';
        l.href = 'https://fonts.googleapis.com/css2?family=' + encodeURIComponent(f.google).replace(/%20/g, '+').replace(/%3A/g, ':').replace(/%2C/g, ',').replace(/%40/g, '@') + '&display=swap';
        document.head.appendChild(l);
        var r = document.documentElement.style;
        r.setProperty('--font-head', f.family);
        r.setProperty('--heavy', String(f.weight));
        r.setProperty('--tight', f.tracking);
        r.setProperty('--stretch-head', f.stretch);
        window.__almFont = f;
      })();
    </script>
  </head>
  <body>
    <div class="wrap">
      <header class="site-header">
        {isHome ? <span></span> : <a class="home-link" href="/">← {site.name}</a>}
        <a class="pill pill--solid" href={site.substack}>Newsletter abonnieren</a>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <a href="/impressum">Impressum</a>
      </footer>
    </div>
    <script is:inline>
      // Hinweis-Leiste im Schrift-Vorschaumodus
      if (window.__almFont) {
        var b = document.createElement('div');
        b.className = 'font-preview';
        b.innerHTML = 'Vorschau: <strong></strong> <a href="/schriften">Alle Schriften</a> <a href="?font=inter">Zurücksetzen</a>';
        b.querySelector('strong').textContent = window.__almFont.name;
        document.body.appendChild(b);
      }
    </script>
  </body>
</html>
